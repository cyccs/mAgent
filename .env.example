# LLM 提供者: vertex (Google Vertex AI Gemini) 或 openai
LLM_PROVIDER=vertex

# Google Vertex AI (LLM_PROVIDER=vertex 时使用)
GCP_CREDENTIALS_PATH=./gcp-credentials.json
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (LLM_PROVIDER=openai 时使用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 通用 LLM 参数
LLM_TEMPERATURE=0.3

# 数据库路径
DATABASE_PATH=./data/running-plan.sqlite
